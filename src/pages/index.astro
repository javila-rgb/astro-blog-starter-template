---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2.5rem 0 3rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.status-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				font-size: 0.8rem;
				font-weight: 700;
				font-family: monospace;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: rgb(var(--black));
				background: rgba(var(--gray-light), 0.7);
				padding: 0.3rem 0.75rem;
				border-radius: 999px;
				margin-bottom: 1.1rem;
			}
			.status-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #10b981;
				box-shadow: 0 0 6px #10b981;
			}
			.hero h1 {
				font-size: 2.65rem;
				line-height: 1.15;
				margin: 0 0 1rem;
			}
			.hero > p {
				font-size: 1.12rem;
				color: rgb(var(--gray-dark));
				margin: 0 0 1.75rem;
				line-height: 1.6;
			}
			.cta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.85rem;
			}
			.btn {
				display: inline-block;
				padding: 0.65rem 1.35rem;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.95rem;
				text-decoration: none;
				transition: transform 0.15s ease, opacity 0.15s ease;
			}
			.btn:hover {
				transform: translateY(-1px);
			}
			.btn-primary {
				background: var(--accent);
				color: #ffffff;
			}
			.btn-primary:hover {
				color: #ffffff;
				opacity: 0.92;
			}
			.btn-secondary {
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
			}
			.btn-secondary:hover {
				color: rgb(var(--black));
			}

			/* High-Contrast Space Telemetry Box */
			.telemetry-box {
				margin-top: 2.25rem;
				padding: 1.4rem 1.5rem;
				border-radius: 12px;
				background: #0f172a;
				color: #ffffff;
				border: 1px solid #334155;
				box-shadow: 0 8px 24px rgba(15, 23, 42, 0.15);
			}
			.telemetry-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				margin-bottom: 0.75rem;
			}
			.telemetry-label {
				font-family: monospace;
				font-size: 0.82rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7dd3fc;
			}
			.telemetry-btn {
				background: #1e293b;
				color: #ffffff;
				border: 1px solid #475569;
				border-radius: 6px;
				padding: 0.35rem 0.75rem;
				font-size: 0.82rem;
				font-weight: 600;
				font-family: monospace;
				cursor: pointer;
				transition: background 0.15s ease, border-color 0.15s ease;
			}
			.telemetry-btn:hover {
				background: #334155;
				border-color: #7dd3fc;
			}
			.telemetry-box .telemetry-text {
				margin: 0;
				font-size: 1.02rem;
				font-weight: 400;
				line-height: 1.6;
				color: #f8fafc !important;
			}

			/* Sections & Cards */
			.section {
				padding: 2.75rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.section:last-of-type {
				border-bottom: none;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1.5rem;
			}
			.section-header h2 {
				margin: 0;
				font-size: 1.55rem;
			}
			.section-header a {
				font-size: 0.95rem;
				font-weight: 700;
				text-decoration: none;
			}

			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 1.25rem;
			}
			.post-card {
				padding: 1.25rem;
				border-radius: 10px;
				border: 1px solid rgb(var(--gray-light));
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.post-card:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 14px rgba(var(--gray), 15%);
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.post-card h3 {
				margin: 0 0 0.35rem;
				font-size: 1.25rem;
				color: rgb(var(--black));
			}
			.post-card:hover h3 {
				color: var(--accent);
			}
			.post-card p {
				margin: 0.5rem 0 0;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			.post-date {
				font-size: 0.85rem;
				font-family: monospace;
				color: rgb(var(--gray));
			}

			.stack-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1.15rem;
			}
			.stack-card {
				padding: 1.25rem;
				border-radius: 10px;
				background: rgba(var(--gray-light), 0.35);
				border: 1px solid rgb(var(--gray-light));
			}
			.stack-tag {
				font-family: monospace;
				font-size: 0.75rem;
				font-weight: 700;
				color: var(--accent);
				text-transform: uppercase;
			}
			.stack-card h3 {
				margin: 0.35rem 0 0.45rem;
				font-size: 1.1rem;
			}
			.stack-card p {
				margin: 0;
				font-size: 0.92rem;
				color: rgb(var(--gray-dark));
				line-height: 1.5;
			}

			@media (max-width: 720px) {
				.hero h1 {
					font-size: 2.05rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="status-pill">
					<span class="status-dot"></span>
					<span>Node: astro.jimmyavila.com // Online</span>
				</div>
				<h1>Homelab Logs, Self-Hosting & Cloud Experiments.</h1>
				<p>
					I’m Jimmy Avila. This is my mission log for local servers, Docker stacks, networking
					rabbitholes, and edge deployments on Cloudflare.
				</p>
				<div class="cta-row">
					<a href="/blog" class="btn btn-primary">Explore Build Logs</a>
					<a href="/about" class="btn btn-secondary">Lab Specs & Bio</a>
				</div>

				<!-- Random Space Fact Widget -->
				<aside class="telemetry-box" aria-live="polite">
					<div class="telemetry-header">
						<span class="telemetry-label">// Deep Space Telemetry</span>
						<button id="next-fact-btn" class="telemetry-btn" type="button">
							New Fact &orarr;
						</button>
					</div>
					<div id="space-fact-text" style="color: #ffffff !important; font-size: 1.05rem; line-height: 1.6;">
						Loading cosmic telemetry...
					</div>
				</aside>
			</section>

			<!-- Recent Blog Posts -->
			<section class="section">
				<div class="section-header">
					<h2>Recent Build Logs</h2>
					<a href="/blog">All entries &rarr;</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<h3>{post.data.title}</h3>
									{post.data.description && <p>{post.data.description}</p>}
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Homelab Stack Overview -->
			<section class="section">
				<div class="section-header">
					<h2>Current Lab Stack</h2>
				</div>
				<div class="stack-grid">
					<div class="stack-card">
						<span class="stack-tag">Edge & DNS</span>
						<h3>Cloudflare</h3>
						<p>Pages hosting, Zero Trust tunnels, and DNS routing without exposing home IPs.</p>
					</div>
					<div class="stack-card">
						<span class="stack-tag">Compute</span>
						<h3>Containers & VMs</h3>
						<p>Self-hosted services, reverse proxies, and automated local backups.</p>
					</div>
					<div class="stack-card">
						<span class="stack-tag">Networking</span>
						<h3>VLANs & Monitoring</h3>
						<p>Segmented IoT/lab traffic, uptime alerts, and local DNS ad-blocking.</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const spaceFacts = [
				"Voyager 1 is over 15 billion miles away, yet its 23-watt transmitter—roughly the power of a refrigerator lightbulb—still sends data back to Earth.",
				"A day on Venus is longer than a year on Venus: it takes 243 Earth days to rotate once, but only 225 Earth days to orbit the Sun.",
				"Neutron stars are so dense that a single teaspoon of neutron-star material would weigh around 4 billion tons on Earth.",
				"In space, two pieces of the exact same type of bare metal will permanently fuse together on contact—a phenomenon known as cold welding.",
				"Olympus Mons on Mars is nearly three times the height of Mount Everest and roughly the size of the entire state of Arizona.",
				"Saturn's moon Titan has thick nitrogen-rich air and rivers, lakes, and seas made of liquid methane and ethane.",
				"Light from the Sun takes about 8 minutes and 20 seconds to reach Earth, meaning we always see the Sun as it looked 8 minutes ago.",
				"The Apollo 11 guidance computer had roughly 72 KB of read-only memory—less than a single modern web icon.",
				"There are more trees on Earth (around 3 trillion) than there are stars in the Milky Way galaxy (estimated at 100 to 400 billion).",
				"Because the Moon has no atmosphere or wind, the footprints left by Apollo astronauts could remain intact for millions of years."
			];

			const factEl = document.getElementById('space-fact-text');
			const btnEl = document.getElementById('next-fact-btn');
			let currentIndex = -1;

			function showRandomFact() {
				if (!factEl) return;
				let nextIndex;
				do {
					nextIndex = Math.floor(Math.random() * spaceFacts.length);
				} while (nextIndex === currentIndex && spaceFacts.length > 1);

				currentIndex = nextIndex;
				factEl.textContent = spaceFacts[currentIndex];
				factEl.style.setProperty('color', '#ffffff', 'important');
}
